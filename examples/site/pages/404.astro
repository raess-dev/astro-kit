---
// The one noindex page. Cloudflare serves it for every unknown path, so it speaks every locale.
import Page from '@raess/astro-kit/components/Page.astro';
import { localeTag, options, pageUrl, t } from '@raess/astro-kit/content';

const first = options.defaultLocale;
const codes = [first, ...options.locales.map((l) => l.code).filter((c) => c !== first)];
---

<Page locale={first} title={t(first, 'notFound')} description={t(first, 'notFound')} noindex>
  {codes.map((code) => (
    <div lang={localeTag(code)}>
      {code === first ? (
        <h1>{t(code, 'notFound')}</h1>
      ) : (
        <p>
          <strong>{t(code, 'notFound')}</strong>
        </p>
      )}
      <p>
        <a href={pageUrl('home', code)}>{t(code, 'home')}</a>
      </p>
    </div>
  ))}
</Page>
