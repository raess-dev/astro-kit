{
  "notes": [
    "The owner applies these once per GitHub organisation (Team plan; site repositories are private):",
    "jq -c '.rulesets[]' github-org-rulesets.json | while read -r r; do gh api -X POST orgs/<org>/rulesets --input - <<<\"$r\"; done",
    "Both target repositories with the custom property kit-site=true, set after the init pull request merges.",
    "The required check is the ci job of site.yml, named 'site / ci'. 29110 is the Dependabot app, the only bypass of the push ruleset.",
    "The owner changes a protected path by disabling the push ruleset for the change, or through an owner bypass once a test repository shows it excludes the Claude app."
  ],
  "rulesets": [
    {
      "name": "kit-site: main",
      "target": "branch",
      "enforcement": "active",
      "conditions": {
        "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] },
        "repository_property": {
          "include": [{ "name": "kit-site", "source": "custom", "property_values": ["true"] }],
          "exclude": []
        }
      },
      "bypass_actors": [],
      "rules": [
        { "type": "deletion" },
        { "type": "non_fast_forward" },
        {
          "type": "pull_request",
          "parameters": {
            "required_approving_review_count": 0,
            "dismiss_stale_reviews_on_push": false,
            "require_code_owner_review": false,
            "require_last_push_approval": false,
            "required_review_thread_resolution": false,
            "allowed_merge_methods": ["squash"]
          }
        },
        {
          "type": "required_status_checks",
          "parameters": {
            "strict_required_status_checks_policy": false,
            "do_not_enforce_on_create": false,
            "required_status_checks": [{ "context": "site / ci", "integration_id": 15368 }]
          }
        }
      ]
    },
    {
      "name": "kit-site: protected paths",
      "target": "push",
      "enforcement": "active",
      "conditions": {
        "repository_property": {
          "include": [{ "name": "kit-site", "source": "custom", "property_values": ["true"] }],
          "exclude": []
        }
      },
      "bypass_actors": [{ "actor_id": 29110, "actor_type": "Integration", "bypass_mode": "always" }],
      "rules": [
        {
          "type": "file_path_restriction",
          "parameters": {
            "restricted_file_paths": [
              ".github/**",
              "wrangler.*",
              "**/wrangler.*",
              ".npmrc",
              "astro-kit.json",
              "src/content/site.json",
              "src/content/pages/*/imprint.md",
              "src/content/pages/*/imprint.mdx",
              "src/content/pages/*/privacy.md",
              "src/content/pages/*/privacy.mdx"
            ]
          }
        }
      ]
    }
  ]
}
