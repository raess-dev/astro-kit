// Managed by @raess/astro-kit, the features.forms variant of wrangler.jsonc. Protected path: the owner changes it.
// The adapter builds the Worker into dist/server and the pages into dist/client; only /api/* runs the Worker first.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "SITE_NAME",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "SITE_HOST", "custom_domain": true }],
  // Mail goes only to verified Email Routing addresses: the client, plus the probe address when set.
  "send_email": [{ "name": "EMAIL", "allowed_destination_addresses": ["CONTACT_TO"] }],
  // 3 messages per 60 s per IP, and 20 per 60 s for the whole form. The endpoint's keys include the site host,
  // so sites in one Cloudflare account can share these namespace ids without sharing counters.
  "ratelimits": [
    { "name": "FORM_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "FORM_RATE_LIMIT_ALL", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // Workers Logs: the endpoint logs error codes only, never form content.
  "observability": { "enabled": true },
  "env": {
    "preview": {
      // Bindings are not inherited: a preview never sends mail.
      "name": "SITE_NAME-preview",
      "routes": [],
      "workers_dev": true,
      "preview_urls": true
    }
  }
}
