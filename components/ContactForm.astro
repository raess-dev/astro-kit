---
/**
 * The contact form for features.forms. It posts to /api/contact/, which answers 303 to this page
 * plus #sent or #not-sent; base.css shows that block with :target. Native validation only, no JS.
 */
import { page, site, t } from '../dist/content.js';
import { CONTACT_ACTION, FIELD, HONEYPOT } from '../dist/forms/limits.js';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const privacy = page('privacy', locale);
const label = (key: keyof typeof FIELD) =>
  `${t(locale, key)} (${t(locale, FIELD[key].required ? 'required' : 'optional')})`;
---

<section id="sent" tabindex="-1">
  <h2>{t(locale, 'sentTitle')}</h2>
  <p>{t(locale, 'sentBody')}</p>
</section>
<section id="not-sent" tabindex="-1">
  <h2>{t(locale, 'notSentTitle')}</h2>
  <p>{t(locale, 'notSentBody')} {site && <a href={`mailto:${site.email}`}>{site.email}</a>}</p>
</section>
<form method="post" action={CONTACT_ACTION}>
  <input type="hidden" name="locale" value={locale}>
  <label for="contact-name">{label('name')}</label>
  <input id="contact-name" name="name" {...FIELD.name}>
  <label for="contact-email">{label('email')}</label>
  <input id="contact-email" name="email" {...FIELD.email}>
  <label for="contact-message">{label('message')}</label>
  <textarea id="contact-message" name="message" {...FIELD.message}></textarea>
  <div class="visually-hidden" inert aria-hidden="true">
    <label for="contact-website">Website</label>
    <input id="contact-website" name={HONEYPOT} type="text" tabindex="-1" autocomplete="off">
  </div>
  {privacy && (
    <p>
      <a href={privacy.path}>{t(locale, 'privacy')}</a>
    </p>
  )}
  <button type="submit">{t(locale, 'send')}</button>
</form>
