---
/**
 * The page shell: the whole document, head to footer. Pass the content record from pagePaths(),
 * or, for a custom route such as 404.astro, { locale, title, description, alternates?, path?, noindex? }.
 * lang marks a main block written in another language than the page locale.
 */

import { getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import '../css/base.css';
import 'virtual:astro-kit/theme.css';
import {
  alternates as alternatesOf,
  localeTag,
  options,
  type PageRecord,
  page as pageOf,
  schedule,
  site,
  siteIndex,
  t,
} from '../dist/content.js';
import { SPECULATION_JSON } from '../dist/csp.js';
import LocaleLinks from './LocaleLinks.astro';

type Props = { lang?: string } & (
  | { page: PageRecord }
  | {
      page?: undefined;
      locale: string;
      title: string;
      description: string;
      alternates?: Record<string, string>;
      path?: string;
      noindex?: boolean;
    }
);

const p = Astro.props;
const record = p.page;
const locale = record ? record.locale : p.locale;
const title = record ? record.title : p.title;
const description = record ? record.description : p.description;
// Drafts only appear in preview builds; they stay out of indexes there too.
const noindex = record ? record.draft : (p.noindex ?? false);
const path = record ? record.path : (p.path ?? (noindex ? undefined : Astro.url.pathname));
const all = record ? alternatesOf(record.id) : (p.alternates ?? {});
const alternates = Object.keys(all).length > 1 ? all : {};
const xDefault = alternates[options.defaultLocale];
const origin = options.site;
const url = path && `${origin}${path}`;
const tag = localeTag(locale);
const ogLocale = (code: string) => localeTag(code).replace('-', '_');
const home = pageOf('home', locale)?.path ?? (locale === options.defaultLocale ? '/' : `/${locale}/`);

// Open Graph image: the entry image, else src/assets/og.jpg, cropped to 1200×630.
const fallback = Object.values(
  import.meta.glob<ImageMetadata>('/src/assets/og.{jpg,jpeg,png}', { eager: true, import: 'default' }),
)[0];
const entryImage = record
  ? ((await getEntry('pages', record.entryId))?.data.image as ImageMetadata | undefined)
  : undefined;
const source = entryImage ?? fallback;
const og =
  source && (await getImage({ src: source, width: 1200, height: 630, fit: 'cover', format: 'jpg', layout: 'none' }));
const ogAlt = (entryImage && record?.imageAlt) || site?.name || title;

// JSON-LD: one organisation @id for every locale, built from site.json and schedule.json only.
const DAYS: Record<string, string> = {
  Mo: 'Monday',
  Tu: 'Tuesday',
  We: 'Wednesday',
  Th: 'Thursday',
  Fr: 'Friday',
  Sa: 'Saturday',
  Su: 'Sunday',
};
const org = { '@id': `${origin}/#org` };
const website = { '@id': `${origin}/#website` };
const by = site ? { publisher: org } : {};
const graph: Record<string, unknown>[] = [];
if (site) {
  const a = site.address;
  graph.push({
    '@type': site.type,
    ...org,
    name: site.name,
    legalName: site.legalName,
    url: `${origin}/`,
    email: site.email,
    telephone: site.phone,
    address: a && {
      '@type': 'PostalAddress',
      streetAddress: a.street,
      postalCode: a.postalCode,
      addressLocality: a.locality,
      addressRegion: a.region,
      addressCountry: a.country,
    },
    vatID: site.vatId,
    sameAs: site.sameAs.length ? site.sameAs : undefined,
    openingHoursSpecification: schedule.openingHours.length
      ? schedule.openingHours.map((h) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: h.days.map((d) => DAYS[d]),
          opens: h.opens,
          closes: h.closes,
        }))
      : undefined,
  });
}
if (url) {
  graph.push({
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: title,
    description,
    inLanguage: tag,
    isPartOf: website,
    ...by,
  });
}
if (path === home) {
  graph.push({
    '@type': 'WebSite',
    ...website,
    url: `${origin}/`,
    name: site?.name ?? title,
    inLanguage: options.locales.map((l) => l.tag),
    ...by,
  });
}
if (url && record?.date) {
  const article = {
    headline: title,
    datePublished: record.date,
    dateModified: record.updated ?? record.date,
    inLanguage: tag,
    mainEntityOfPage: { '@id': `${url}#webpage` },
  };
  graph.push({
    '@type': 'Article',
    ...article,
    ...(og ? { image: `${origin}${og.src}` } : {}),
    ...(site ? { author: org, ...by } : {}),
  });
}
// Escaping < keeps a title from closing the script element.
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');

// Navigation labels: a nav.<id> message when the project defines one, else the title up to its first dash.
const label = (r: PageRecord): string => {
  try {
    return t(locale, `nav.${r.id}`);
  } catch {
    return r.title.split(/ [–—|-] /)[0] ?? r.title;
  }
};
const links = (ids: readonly string[], text: (r: PageRecord) => string) =>
  ids.flatMap((id) => {
    const r = pageOf(id, locale);
    return r ? [{ href: r.path, text: text(r), current: r.path === path ? 'page' : undefined }] : [];
  });
const nav = links(options.nav, label);
const footer = links(['contact', 'imprint', 'privacy', 'sitemap'], (r) => t(locale, r.id));
const index = record?.id === 'sitemap' ? siteIndex(locale).filter((r) => r.path !== path) : [];
---

<!doctype html>
<html lang={tag}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    {url && <link rel="canonical" href={url}>}
    {Object.entries(alternates).map(([code, href]) => <link rel="alternate" hreflang={localeTag(code)} href={href}>)}
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault}>}
    {noindex && <meta name="robots" content="noindex">}
    <meta property="og:type" content={record?.date ? 'article' : 'website'}>
    <meta property="og:site_name" content={site?.name ?? title}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    {url && <meta property="og:url" content={url}>}
    <meta property="og:locale" content={ogLocale(locale)}>
    {Object.keys(alternates)
      .filter((code) => code !== locale)
      .map((code) => <meta property="og:locale:alternate" content={ogLocale(code)}>)}
    {og && (
      <>
        <meta property="og:image" content={`${origin}${og.src}`}>
        <meta property="og:image:width" content="1200">
        <meta property="og:image:height" content="630">
        <meta property="og:image:alt" content={ogAlt}>
      </>
    )}
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <script type="application/ld+json" set:html={jsonld} />
  </head>
  <body>
    <a href="#main">{t(locale, 'skip')}</a>
    <header>
      <a href={home} aria-current={path === home ? 'page' : undefined}>{site?.name ?? title}</a>
      <nav aria-label={t(locale, 'nav')}>
        {nav.length > 0 && (
          <ul>
            {nav.map((l) => (
              <li>
                <a href={l.href} aria-current={l.current}>
                  {l.text}
                </a>
              </li>
            ))}
          </ul>
        )}
        <LocaleLinks locale={locale} id={record?.id} />
        <details>
          <summary>{t(locale, 'menu')}</summary>
          {nav.length > 0 && (
            <ul>
              {nav.map((l) => (
                <li>
                  <a href={l.href} aria-current={l.current}>
                    {l.text}
                  </a>
                </li>
              ))}
            </ul>
          )}
          <LocaleLinks locale={locale} id={record?.id} />
        </details>
      </nav>
    </header>
    <main id="main" tabindex="-1" lang={p.lang}>
      <slot />
      {index.length > 0 && (
        <ul>
          {index.map((r) => (
            <li>
              <a href={r.path}>{r.title}</a>
            </li>
          ))}
        </ul>
      )}
    </main>
    <footer>
      {site && (
        <address>
          {site.name}
          <br>
          {site.address ? (
            <>
              {site.address.street}
              <br>
              {site.address.postalCode} {site.address.locality}
              <br>
            </>
          ) : null}
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      )}
      {footer.length > 0 && (
        <ul>
          {footer.map((l) => (
            <li>
              <a href={l.href} aria-current={l.current}>
                {l.text}
              </a>
            </li>
          ))}
        </ul>
      )}
    </footer>
    {options.prefetch.speculationRules && <script type="speculationrules" set:html={SPECULATION_JSON} />}
  </body>
</html>
