{
  "site": "https://laerchenwald.example",
  "codeOwner": "@raess",
  "locales": [
    {
      "code": "de",
      "tag": "de-CH",
      "name": "Deutsch",
      "coverage": "full"
    },
    {
      "code": "fr",
      "tag": "fr-CH",
      "name": "Français",
      "coverage": "full"
    },
    {
      "code": "en",
      "tag": "en",
      "name": "English",
      "coverage": "partial"
    }
  ],
  "defaultLocale": "de",
  "features": {
    "forms": true,
    "islands": false,
    "scripts": false,
    "wasm": false,
    "workers": false
  },
  "prefetch": {
    "speculationRules": true,
    "astroPrefetch": false
  },
  "modes": {
    "auto": true,
    "light": true,
    "dark": true,
    "contrast": true
  },
  "contact": {
    "to": "info@laerchenwald.example",
    "from": "form@laerchenwald.example"
  },
  "forms": {
    "contact": {
      "fields": [
        {
          "name": "name",
          "type": "text"
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "message",
          "type": "textarea"
        }
      ]
    },
    "booking": {
      "fields": [
        {
          "name": "name",
          "type": "text"
        },
        {
          "name": "email",
          "type": "email"
        },
        {
          "name": "tel",
          "type": "tel",
          "required": false
        },
        {
          "name": "arrival",
          "type": "date"
        },
        {
          "name": "nights",
          "type": "number",
          "min": 1,
          "max": 14
        },
        {
          "name": "room",
          "type": "choice",
          "options": [
            "single",
            "double",
            "family"
          ]
        },
        {
          "name": "terms",
          "type": "consent"
        }
      ]
    }
  },
  "legal": {
    "legalNote": {
      "de": "/impressum/",
      "fr": "/fr/mentions-legales/",
      "en": "/en/legal-note/"
    },
    "privacy": {
      "de": "/datenschutz/",
      "fr": "/fr/protection-des-donnees/",
      "en": "/en/privacy/"
    }
  },
  "processing": [
    "cdn",
    "previews",
    "forms",
    "server"
  ],
  "securityContact": "mailto:security@laerchenwald.example",
  "dependencies": [],
  "origins": [],
  "waivers": [],
  "limits": {}
}
