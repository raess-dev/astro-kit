{
  "_": "The dist/server/wrangler.json that a forms build of test/site writes (@astrojs/cloudflare 14.4.9, wrangler 4.165.0), for production and with CLOUDFLARE_ENV=preview; the two paths are shortened.",
  "production": {
    "configPath": "/site/wrangler.jsonc",
    "userConfigPath": "/site/wrangler.jsonc",
    "topLevelName": "laerchenwald-example",
    "definedEnvironments": ["preview"],
    "compatibility_date": "2026-11-01",
    "compatibility_flags": [],
    "jsx_factory": "React.createElement",
    "jsx_fragment": "React.Fragment",
    "rules": [
      {
        "type": "ESModule",
        "globs": ["**/*.js", "**/*.mjs"]
      }
    ],
    "name": "laerchenwald-example",
    "main": "entry.mjs",
    "routes": [
      {
        "pattern": "laerchenwald.example",
        "custom_domain": true
      }
    ],
    "triggers": {},
    "assets": {
      "directory": "../client",
      "not_found_handling": "404-page",
      "html_handling": "auto-trailing-slash",
      "run_worker_first": ["/api/forms/*"],
      "binding": "ASSETS"
    },
    "workers_dev": false,
    "preview_urls": false,
    "vars": {},
    "durable_objects": {
      "bindings": []
    },
    "workflows": [],
    "migrations": [],
    "exports": {},
    "kv_namespaces": [],
    "cloudchamber": {},
    "send_email": [
      {
        "name": "EMAIL",
        "allowed_destination_addresses": ["info@laerchenwald.example"]
      }
    ],
    "queues": {
      "producers": [],
      "consumers": []
    },
    "connect": [],
    "r2_buckets": [],
    "d1_databases": [],
    "vectorize": [],
    "ai_search_namespaces": [],
    "ai_search": [],
    "agent_memory": [],
    "hyperdrive": [],
    "services": [],
    "analytics_engine_datasets": [],
    "dispatch_namespaces": [],
    "mtls_certificates": [],
    "pipelines": [],
    "k2": [],
    "secrets_store_secrets": [],
    "artifacts": [],
    "unsafe_hello_world": [],
    "flagship": [],
    "worker_loaders": [],
    "ratelimits": [
      {
        "name": "FORM_RATE_LIMIT",
        "namespace_id": "1001",
        "simple": {
          "limit": 3,
          "period": 60
        }
      },
      {
        "name": "FORM_RATE_LIMIT_ALL",
        "namespace_id": "1002",
        "simple": {
          "limit": 20,
          "period": 60
        }
      }
    ],
    "vpc_services": [],
    "vpc_networks": [],
    "logfwdr": {
      "bindings": []
    },
    "upload_source_maps": true,
    "observability": {
      "enabled": true
    },
    "python_modules": {
      "exclude": ["**/*.pyc"]
    },
    "previews": {},
    "dev": {
      "ip": "localhost",
      "local_protocol": "http",
      "upstream_protocol": "http",
      "enable_containers": true,
      "generate_types": false
    },
    "no_bundle": true
  },
  "preview": {
