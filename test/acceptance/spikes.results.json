    "serverIsland": "NoAdapterInstalledServerIslands",
    "middleware": "runs in the build"
  },
  "S19.static.routes": [
    {
      "pattern": "/",
      "origin": "project",
      "prerender": true,
      "entrypoint": "src/pages/index.astro",
      "type": "page"
    },
    {
      "pattern": "/404",
      "origin": "project",
      "prerender": true,
      "entrypoint": "src/pages/404.astro",
      "type": "page"
    },
    {
      "pattern": "/_image",
      "origin": "internal",
      "prerender": false,
      "entrypoint": "node_modules/astro/dist/assets/endpoint/dev.js",
      "type": "endpoint"
    },
    {
      "pattern": "/_server-islands/[name]",
      "origin": "internal",
      "prerender": false,
      "entrypoint": "_server-islands.astro",
      "type": "page"
    }
  ],
  "S19.worker": {
    "/_actions/x": {
      "get": 404,
      "post": 404
    },
    "/_actions/x/": {
      "get": 404,
      "post": 404
    },
    "/_server-islands/x": {
      "get": 404,
      "post": 404
    },
    "/_server-islands/x/": {
      "get": 400,
      "post": 404
    },
    "/_image": {
      "get": 404,
      "post": 404
    },
    "/_image?href=%2F_astro%2Fx.png&w=10&f=webp": {
      "get": 404,
      "post": 404
    },
    "/x/": {
      "get": 404,
      "post": 404
    }
  }
}
