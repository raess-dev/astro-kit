{
  "$schema": "../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "files": {
    "includes": ["**", "!**/dist", "!**/.astro", "!**/.wrangler", "!**/node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "single" }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": { "enabled": true, "indentScriptAndStyle": true }
  },
  "markdown": {
    "formatter": { "enabled": false }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useNodejsImportProtocol": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "astro:i18n": "The kit builds every URL: use alternates() and pagePaths() from @raess/astro-kit/content.",
              "astro:transitions": "No ClientRouter: native CSS view transitions keep the CSP strict."
            },
            "patterns": [
              {
                "group": ["astro:i18n/**", "astro:transitions/**"],
                "message": "The kit builds every URL and uses native CSS view transitions: see node_modules/@raess/astro-kit/docs/INDEX.md."
              }
            ]
          }
        }
      },
      "suspicious": "error"
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "suspicious": {
            "useBaseline": {
              "level": "error",
              "options": {
                "available": 2024,
                "allowAtRules": ["view-transition"],
                "allowProperties": ["accent-color", "resize"],
                "allowPropertyValues": { "text-wrap": ["pretty"] }
              }
            },
            "noUnknownAttribute": "off",
            "useExpect": "off",
            "noMisplacedAssertion": "off",
            "noConditionalExpect": "off"
          }
        }
      }
    },
    {
      "includes": ["**/astro-kit.json"],
      "json": { "formatter": { "expand": "always" } }
    }
  ]
}
