{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["./config/biome.json"],
  "files": {
    "includes": [
      "!**/dist",
      "!**/.astro",
      "!**/node_modules",
      "!test/fixtures/good",
      "!test/fixtures/islands",
      "!test/fixtures/.work",
      "!docs/standards.md"
    ]
  },
  "overrides": [
    {
      "includes": ["src/**", "test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noBitwiseOperators": "off"
          }
        }
      }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off",
            "noTemplateCurlyInString": "off"
          }
        }
      }
    },
    {
      "includes": ["src/browser.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noPlaywrightWaitForTimeout": "off",
            "noLoopFunc": "off"
          }
        }
      }
    },
    {
      "includes": ["css/base.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          },
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
