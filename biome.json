{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "extends": ["./config/biome.json"],
  "files": {
    "includes": ["!**/dist", "!**/.astro", "!**/.wrangler", "!**/node_modules", "!test/site"]
  },
  "overrides": [
    {
      "includes": ["css/base.css", "test/acceptance/kit/base.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    },
    {
      "includes": [
        "test/acceptance/kit/speculation.json",
        "test/acceptance/kit/tokens-setting-1.css",
        "test/acceptance/spikes.results.json"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["templates/site/src/styles/tokens.css", "templates/site/src/styles/elements.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlock": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
