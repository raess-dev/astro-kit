{
  "name": "@raess/astro-kit",
  "version": "0.0.0",
  "description": "One Astro integration and one CLI that enforce a standard for fast, secure, accessible multilingual marketing sites.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raess-dev/astro-kit.git"
  },
  "keywords": [
    "astro-integration",
    "withastro"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "css",
    "config",
    "docs/INDEX.md",
    "docs/standards.md",
    "docs/forms.md",
    "docs/islands.md",
    "docs/modes.md",
    "docs/origins.md",
    "docs/recipes",
    "schema",
    "templates",
    "CHANGELOG.md"
  ],
  "bin": {
    "astro-kit": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "default": "./dist/forms/index.js"
    },
    "./css/base.css": "./css/base.css",
    "./biome.json": "./config/biome.json",
    "./tsconfig.json": "./config/tsconfig.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome ci --error-on-warnings . && tsc -p tsconfig.json --noEmit",
    "test": "node --test 'test/unit/**/*.test.ts'",
    "docs": "node src/docs.ts --write"
  },
  "peerDependencies": {
    "@astrojs/cloudflare": ">=14.4.6 <15",
    "@astrojs/solid-js": ">=7.1.2 <8",
    "astro": ">=7.4.8 <8",
    "solid-js": ">=1.9.18 <2"
  },
  "peerDependenciesMeta": {
    "@astrojs/cloudflare": {
      "optional": true
    },
    "@astrojs/solid-js": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.7",
    "axe-core": "4.14.0",
    "html-validate": "11.21.1",
    "node-html-parser": "9.0.7",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "14.4.7",
    "@astrojs/solid-js": "7.1.5",
    "@types/node": "22.20.5",
    "astro": "7.4.11",
    "solid-js": "1.9.19",
    "yaml": "2.9.1"
  }
}
